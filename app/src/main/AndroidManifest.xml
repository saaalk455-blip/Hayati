<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Hayati declares no permissions: Phase 2 needs no network, location or storage access.
        (AndroidX merges one internal signature-level permission, DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION,
        which is scoped to this app and is not shown to the user.)
    -->

    <application
        android:name=".HayatiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hayati">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hayati">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
